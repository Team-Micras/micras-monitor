{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tests-browser.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "vite-plugin-pwa/client"],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@robots/*": ["./robots/*"],
      "@tests/*": ["./tests/*"],
      "@scripts/*": ["./scripts/*"]
    }
  },
  "include": ["tests/**/*.tsx", "tests/support/app", "tests/support/axe-check.ts"]
}
