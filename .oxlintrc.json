{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "react", "jsx-a11y", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "options": {
    "typeAware": true,
    "denyWarnings": true
  },
  "env": {
    "builtin": true,
    "es2024": true
  },
  "ignorePatterns": ["dist/**", "node_modules/**", ".omc/**"],
  "rules": {
    "import/no-cycle": "error",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"]
      }
    ],
    "vitest/expect-expect": [
      "error",
      {
        "assertFunctionNames": ["expect", "expect*"]
      }
    ],
    "react/react-in-jsx-scope": "off",
    "react/only-export-components": [
      "error",
      {
        "allowConstantExport": true,
        "allowExportNames": ["buttonVariants", "badgeVariants"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["sw/**"],
      "rules": {
        "no-underscore-dangle": "off"
      }
    },
    {
      "files": ["tests/e2e/**"],
      "rules": {
        "no-await-in-loop": "off"
      }
    },
    {
      "files": ["src/**", "robots/**", "tests/**"],
      "env": {
        "browser": true
      }
    },
    {
      "files": ["src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^((@tests|@scripts)|(\\.\\./)+(tests|scripts))(/|$)",
                "message": "Shipped code never imports tests or scripts."
              },
              {
                "regex": "^react(-dom)?(/.*)?$",
                "message": "Only src/app may use React; keep this layer framework free."
              },
              {
                "regex": "^(@robots(/|$)|(\\.{1,2}/)+(.+/)?robots(/|$))",
                "message": "Nothing in src/ imports a robot package; robots register through the app."
              },
              {
                "regex": "^(@/app(/|$)|(\\.\\./)+app(/|$))",
                "message": "Layers below the app must not depend on it."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/app/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^((@tests|@scripts)|(\\.\\./)+(tests|scripts))(/|$)",
                "message": "Shipped code never imports tests or scripts."
              },
              {
                "regex": "^(@robots(/|$)|(\\.{1,2}/)+(.+/)?robots(/|$))",
                "message": "Nothing in src/ imports a robot package; robots register through the app."
              },
              {
                "regex": "^(@/(protocol|link)|(\\.\\./)+(protocol|link))(/|$)",
                "message": "Only src/app/live speaks micras_comm; the rest of the app uses the model of src/core."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/app/live/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^((@tests|@scripts)|(\\.\\./)+(tests|scripts))(/|$)",
                "message": "Shipped code never imports tests or scripts."
              },
              {
                "regex": "^(@robots(/|$)|(\\.{1,2}/)+(.+/)?robots(/|$))",
                "message": "Nothing in src/ imports a robot package; robots register through the app."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/lazy/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^((@tests|@scripts)|(\\.\\./)+(tests|scripts))(/|$)",
                "message": "Shipped code never imports tests or scripts."
              },
              {
                "regex": "^(@robots(/|$)|(\\.{1,2}/)+(.+/)?robots(/|$))",
                "message": "Nothing in src/ imports a robot package; robots register through the app."
              },
              {
                "regex": "^(@/app(/|$)|(\\.\\./)+app(/|$))",
                "message": "Layers below the app must not depend on it."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/core/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^((@tests|@scripts)|(\\.\\./)+(tests|scripts))(/|$)",
                "message": "Shipped code never imports tests or scripts."
              },
              {
                "regex": "^react(-dom)?(/.*)?$",
                "message": "Only src/app may use React; keep this layer framework free."
              },
              {
                "regex": "^(@/|@robots(/|$)|(\\.\\./)+)",
                "message": "src/core imports nothing else in the monitor."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/protocol/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^((@tests|@scripts)|(\\.\\./)+(tests|scripts))(/|$)",
                "message": "Shipped code never imports tests or scripts."
              },
              {
                "regex": "^react(-dom)?(/.*)?$",
                "message": "Only src/app may use React; keep this layer framework free."
              },
              {
                "regex": "^(@/(core|link|telemetry|tiling|robot-kit|app)|@robots|(\\.\\./)+(core|link|telemetry|tiling|robot-kit|app|robots))(/|$)",
                "message": "src/protocol depends on nothing else in the monitor."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/link/**"],
      "rules": {
        "no-await-in-loop": "off",
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^((@tests|@scripts)|(\\.\\./)+(tests|scripts))(/|$)",
                "message": "Shipped code never imports tests or scripts."
              },
              {
                "regex": "^react(-dom)?(/.*)?$",
                "message": "Only src/app may use React; keep this layer framework free."
              },
              {
                "regex": "^(@/(telemetry|tiling|robot-kit|app)|@robots|(\\.\\./)+(telemetry|tiling|robot-kit|app|robots|scripts))(/|$)",
                "message": "src/link depends only on src/protocol and src/core."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/telemetry/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^((@tests|@scripts)|(\\.\\./)+(tests|scripts))(/|$)",
                "message": "Shipped code never imports tests or scripts."
              },
              {
                "regex": "^react(-dom)?(/.*)?$",
                "message": "Only src/app may use React; keep this layer framework free."
              },
              {
                "regex": "^(@/(protocol|link|tiling|robot-kit|app)|@robots|(\\.\\./)+(protocol|link|tiling|robot-kit|app|robots))(/|$)",
                "message": "src/telemetry depends only on src/core."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/tiling/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^((@tests|@scripts)|(\\.\\./)+(tests|scripts))(/|$)",
                "message": "Shipped code never imports tests or scripts."
              },
              {
                "regex": "^react(-dom)?(/.*)?$",
                "message": "Only src/app may use React; keep this layer framework free."
              },
              {
                "regex": "^(@/(core|protocol|link|telemetry|robot-kit|app)|@robots|(\\.\\./)+(core|protocol|link|telemetry|robot-kit|app|robots))(/|$)",
                "message": "src/tiling depends on nothing else in the monitor."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/robot-kit/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^((@tests|@scripts)|(\\.\\./)+(tests|scripts))(/|$)",
                "message": "Shipped code never imports tests or scripts."
              },
              {
                "regex": "^react(-dom)?(/.*)?$",
                "message": "Only src/app may use React; keep this layer framework free."
              },
              {
                "regex": "^(@/(protocol|link|telemetry|tiling|app)|@robots|(\\.\\./)+(protocol|link|telemetry|tiling|app|robots))(/|$)",
                "message": "src/robot-kit depends only on src/core."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["robots/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^((@tests|@scripts)|(\\.\\./)+(tests|scripts))(/|$)",
                "message": "Shipped code never imports tests or scripts."
              },
              {
                "regex": "^(@/(protocol|link|telemetry|tiling|app)|(\\.\\./)+(src/(protocol|link|telemetry|tiling|app)))(/|$)",
                "message": "Robot packages depend only on src/robot-kit, src/core and React."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/main.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^((@tests|@scripts)|(\\.\\./)+(tests|scripts))(/|$)",
                "message": "Shipped code never imports tests or scripts."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "scripts/**",
        "*.config.ts",
        "tests/e2e/**",
        "tests/scripts/**",
        "tests/config/**",
        "tests/link/session-simulated.test.ts",
        "tests/link/session-faults.test.ts",
        "tests/support/browser-*.ts",
        "tests/support/in-memory-robot.ts",
        "tests/support/session-harness.ts",
        "tests/support/virtual-time.ts"
      ],
      "env": {
        "node": true
      }
    },
    {
      "files": [
        "tests/support/**",
        "tests/scripts/**",
        "tests/link/session-simulated.test.ts",
        "tests/link/session-faults.test.ts"
      ],
      "rules": {
        "no-await-in-loop": "off"
      }
    },
    {
      "files": ["scripts/**"],
      "rules": {
        "no-await-in-loop": "off",
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(@tests|(\\.\\./)+tests)(/|$)",
                "message": "Scripts never import tests."
              },
              {
                "regex": "^(@/(telemetry|tiling|robot-kit|app)|@robots|(\\.\\./)+(src/(telemetry|tiling|robot-kit|app)|robots))(/|$)",
                "message": "Tools may only depend on src/protocol and src/link."
              },
              {
                "regex": "^react(-dom)?(/.*)?$",
                "message": "Tools are Node scripts; no React."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["scripts/simulated-robot/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(@tests|(\\.\\./)+tests)(/|$)",
                "message": "Scripts never import tests."
              },
              {
                "regex": "^(@/(link|telemetry|tiling|robot-kit|app)|@robots|(\\.\\./)+(src/(link|telemetry|tiling|robot-kit|app)|robots))(/|$)",
                "message": "The simulated robot stands in for the firmware and speaks only src/protocol."
              },
              {
                "regex": "^react(-dom)?(/.*)?$",
                "message": "Tools are Node scripts; no React."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["tests/app/live/live-robot.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(@/(tiling|robot-kit)|@robots|(\\.\\./)+(src/(tiling|robot-kit)|robots))(/|$)",
                "message": "The live robot's test drives the app's live adapter against the simulated robot, and nothing else of the app."
              },
              {
                "regex": "^react(-dom)?(/.*)?$",
                "message": "Tools are Node scripts; no React."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["tests/scripts/simulated-maze.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(@/(telemetry|tiling|robot-kit|app)|(\\.\\./)+src/(telemetry|tiling|robot-kit|app))(/|$)",
                "message": "The simulated maze's test checks the record against the Micras package, and nothing else of the monitor."
              },
              {
                "regex": "^react(-dom)?(/.*)?$",
                "message": "Tools are Node scripts; no React."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["scripts/bench-telemetry.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(@tests|(\\.\\./)+tests)(/|$)",
                "message": "Scripts never import tests."
              },
              {
                "regex": "^(@/(protocol|link|tiling|robot-kit|app)|@robots|(\\.\\./)+(src/(protocol|link|tiling|robot-kit|app)|robots))(/|$)",
                "message": "The telemetry benchmark may only depend on src/core and src/telemetry."
              },
              {
                "regex": "^react(-dom)?(/.*)?$",
                "message": "Tools are Node scripts; no React."
              }
            ]
          }
        ]
      }
    }
  ]
}
