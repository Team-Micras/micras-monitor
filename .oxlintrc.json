{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "react", "jsx-a11y", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "options": {
    "typeAware": true,
    "denyWarnings": true
  },
  "env": {
    "builtin": true,
    "es2024": true
  },
  "ignorePatterns": ["dist/**", "node_modules/**", ".omc/**"],
  "rules": {
    "import/no-cycle": "error",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"]
      }
    ],
    "vitest/expect-expect": [
      "error",
      {
        "assertFunctionNames": ["expect", "expect*"]
      }
    ],
    "react/react-in-jsx-scope": "off",
    "react/only-export-components": [
      "error",
      {
        "allowConstantExport": true,
        "allowExportNames": ["buttonVariants", "badgeVariants"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["sw/**"],
      "rules": {
        "no-underscore-dangle": "off"
      }
    },
    {
      "files": ["tests/e2e/**"],
      "rules": {
        "no-await-in-loop": "off"
      }
    },
    {
      "files": ["src/**", "tests/**"],
      "env": {
        "browser": true
      }
    },
    {
      "files": ["src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^((@tests|@scripts)|(\\.\\./)+(tests|scripts))(/|$)",
                "message": "Shipped code never imports tests or scripts."
              },
              {
                "regex": "^react(-dom)?(/.*)?$",
                "message": "Only src/ui and the robot packages draw with React; keep this folder framework free."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/core/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^((@tests|@scripts)|(\\.\\./)+(tests|scripts))(/|$)",
                "message": "Shipped code never imports tests or scripts."
              },
              {
                "regex": "^react(-dom)?(/.*)?$",
                "message": "Only src/ui and the robot packages draw with React; keep this folder framework free."
              },
              {
                "regex": "^@/",
                "message": "src/core imports nothing else in the monitor; import other core modules by relative path."
              },
              {
                "regex": "^(@/(history|recording|tiling|sources|robots|ui|main)|(\\.\\./)+(history|recording|tiling|sources|robots|ui|main))(/|$)",
                "message": "src/core imports nothing else in the monitor; import other core modules by relative path."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/history/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^((@tests|@scripts)|(\\.\\./)+(tests|scripts))(/|$)",
                "message": "Shipped code never imports tests or scripts."
              },
              {
                "regex": "^react(-dom)?(/.*)?$",
                "message": "Only src/ui and the robot packages draw with React; keep this folder framework free."
              },
              {
                "regex": "^(@/(recording|tiling|sources|robots|ui|main)|(\\.\\./)+(recording|tiling|sources|robots|ui|main))(/|$)",
                "message": "src/history depends only on src/core."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/recording/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^((@tests|@scripts)|(\\.\\./)+(tests|scripts))(/|$)",
                "message": "Shipped code never imports tests or scripts."
              },
              {
                "regex": "^react(-dom)?(/.*)?$",
                "message": "Only src/ui and the robot packages draw with React; keep this folder framework free."
              },
              {
                "regex": "^(@/(tiling|sources|robots|ui|main)|(\\.\\./)+(tiling|sources|robots|ui|main))(/|$)",
                "message": "src/recording depends only on src/core and src/history."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/tiling/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^((@tests|@scripts)|(\\.\\./)+(tests|scripts))(/|$)",
                "message": "Shipped code never imports tests or scripts."
              },
              {
                "regex": "^react(-dom)?(/.*)?$",
                "message": "Only src/ui and the robot packages draw with React; keep this folder framework free."
              },
              {
                "regex": "^@/",
                "message": "src/tiling is a pure engine and imports nothing else in the monitor."
              },
              {
                "regex": "^(@/(core|history|recording|sources|robots|ui|main)|(\\.\\./)+(core|history|recording|sources|robots|ui|main))(/|$)",
                "message": "src/tiling is a pure engine and imports nothing else in the monitor."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/sources/micras-comm/**"],
      "rules": {
        "no-await-in-loop": "off",
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^((@tests|@scripts)|(\\.\\./)+(tests|scripts))(/|$)",
                "message": "Shipped code never imports tests or scripts."
              },
              {
                "regex": "^react(-dom)?(/.*)?$",
                "message": "Only src/ui and the robot packages draw with React; keep this folder framework free."
              },
              {
                "regex": "^(@/(history|recording|tiling|robots|ui|main)|(\\.\\./)+(history|recording|tiling|robots|ui|main))(/|$)",
                "message": "A source depends only on src/core and its own folder; it never reaches the UI, the history, the recordings, the tiling engine or a robot package."
              },
              {
                "regex": "^(@/sources/demo|(\\.\\./)+(sources/)?demo)(/|$)",
                "message": "A source never imports another source."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/sources/demo/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^((@tests|@scripts)|(\\.\\./)+(tests|scripts))(/|$)",
                "message": "Shipped code never imports tests or scripts."
              },
              {
                "regex": "^react(-dom)?(/.*)?$",
                "message": "Only src/ui and the robot packages draw with React; keep this folder framework free."
              },
              {
                "regex": "^(@/(history|recording|tiling|robots|ui|main)|(\\.\\./)+(history|recording|tiling|robots|ui|main))(/|$)",
                "message": "A source depends only on src/core and its own folder; it never reaches the UI, the history, the recordings, the tiling engine or a robot package."
              },
              {
                "regex": "^(@/sources/micras-comm|(\\.\\./)+(sources/)?micras-comm)(/|$)",
                "message": "A source never imports another source."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/robots/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^((@tests|@scripts)|(\\.\\./)+(tests|scripts))(/|$)",
                "message": "Shipped code never imports tests or scripts."
              },
              {
                "regex": "^(@/(history|recording|tiling|sources|main)|(\\.\\./)+(history|recording|tiling|sources|main))(/|$)",
                "message": "A robot package depends only on src/core, with src/core/robot as its contract, and React."
              },
              {
                "group": ["@/ui/*", "!@/ui/lazy", "!@/ui/lazy/*"],
                "message": "Of the UI, a robot package may only use src/ui/lazy to load its views on demand."
              },
              {
                "regex": "^(\\.\\./)+ui(/|$)",
                "message": "Of the UI, a robot package may only use src/ui/lazy, and through @/ui/lazy."
              },
              {
                "regex": "^(@/robots/|(\\.\\./)+robots/)",
                "message": "A robot package never imports another one."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/ui/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^((@tests|@scripts)|(\\.\\./)+(tests|scripts))(/|$)",
                "message": "Shipped code never imports tests or scripts."
              },
              {
                "regex": "^(@/(sources|robots|main)|(\\.\\./)+(sources|robots|main))(/|$)",
                "message": "The UI reads the monitor of src/core; only src/main.tsx wires sources and robot packages in."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/main.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^((@tests|@scripts)|(\\.\\./)+(tests|scripts))(/|$)",
                "message": "Shipped code never imports tests or scripts."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "scripts/**",
        "*.config.ts",
        "tests/e2e/**",
        "tests/scripts/**",
        "tests/config/**",
        "tests/sources/micras-comm/link/robot-link-simulated.test.ts",
        "tests/sources/micras-comm/link/robot-link-faults.test.ts",
        "tests/support/browser-*.ts",
        "tests/support/sources/micras-comm/in-memory-robot.ts",
        "tests/support/sources/micras-comm/link-harness.ts",
        "tests/support/virtual-time.ts"
      ],
      "env": {
        "node": true
      }
    },
    {
      "files": [
        "tests/support/**",
        "tests/scripts/**",
        "tests/sources/micras-comm/link/robot-link-simulated.test.ts",
        "tests/sources/micras-comm/link/robot-link-faults.test.ts"
      ],
      "rules": {
        "no-await-in-loop": "off"
      }
    },
    {
      "files": ["scripts/**"],
      "rules": {
        "no-await-in-loop": "off",
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(@tests|(\\.\\./)+tests)(/|$)",
                "message": "Scripts never import tests."
              },
              {
                "regex": "^(@/(history|recording|tiling|core/robot|robots|ui)|(\\.\\./)+src/(history|recording|tiling|core/robot|robots|ui))(/|$)",
                "message": "Scripts may only depend on src/core and the sources."
              },
              {
                "regex": "^react(-dom)?(/.*)?$",
                "message": "Tools are Node scripts; no React."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["scripts/simulated-robot/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(@tests|(\\.\\./)+tests)(/|$)",
                "message": "Scripts never import tests."
              },
              {
                "regex": "^(@/(history|recording|tiling|core/robot|robots|ui|sources/demo|sources/micras-comm/(link|streaming|transports))|(\\.\\./)+src/(history|recording|tiling|core/robot|robots|ui|sources/demo|sources/micras-comm/(link|streaming|transports)))(/|$)",
                "message": "The simulated robot stands in for the firmware and speaks only the micras_comm wire format of src/sources/micras-comm/wire."
              },
              {
                "regex": "^react(-dom)?(/.*)?$",
                "message": "Tools are Node scripts; no React."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["tests/sources/micras-comm/micras-comm-source.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(@/(ui|tiling|core/robot|robots)|(\\.\\./)+src/(ui|tiling|core/robot|robots))(/|$)",
                "message": "The micras-comm source's test drives the source and the monitor against the simulated robot, and nothing of the UI."
              },
              {
                "regex": "^react(-dom)?(/.*)?$",
                "message": "Tools are Node scripts; no React."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["tests/scripts/simulated-maze.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(@/(history|recording|tiling|core/robot|ui)|(\\.\\./)+src/(history|recording|tiling|core/robot|ui))(/|$)",
                "message": "The simulated maze's test checks the record against the Micras package, and nothing else of the monitor."
              },
              {
                "regex": "^react(-dom)?(/.*)?$",
                "message": "Tools are Node scripts; no React."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["scripts/bench-telemetry.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(@tests|(\\.\\./)+tests)(/|$)",
                "message": "Scripts never import tests."
              },
              {
                "regex": "^(@/(recording|tiling|core/robot|robots|ui|sources)|(\\.\\./)+src/(recording|tiling|core/robot|robots|ui|sources))(/|$)",
                "message": "The history benchmark may only depend on src/core and src/history."
              },
              {
                "regex": "^react(-dom)?(/.*)?$",
                "message": "Tools are Node scripts; no React."
              }
            ]
          }
        ]
      }
    }
  ]
}
